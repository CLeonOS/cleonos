ninja_required_version = 1.10

rule cc
  command = mkdir -p "$$(dirname "$out")" && $cc $cflags -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CC $label

rule cxx
  command = mkdir -p "$$(dirname "$out")" && $cc $cflags -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CXX $label

rule link
  command = mkdir -p "$$(dirname "$out")" && $ld $ldflags -T $linker -o $out $in
  description = LD $out

rule uefi
  command = mkdir -p "$$(dirname "$out")" && $uefi_cc $uefi_cflags $in -o $out $uefi_ldflags
  description = UEFI $out

rule rust_staticlib
  command = mkdir -p "$$(dirname "$out")" && $rustc $flags $in -o $out
  description = RUST $out

rule run
  command = $cmd
  description = RUN $desc

rule console
  command = $cmd
  description = RUN $desc
  pool = console

build build/bdt-freestanding/include/assert.h: run
  cmd = mkdir -p build/bdt-freestanding/include && printf '%s\n' '#ifndef BDT_FREESTANDING_ASSERT_H' '#define BDT_FREESTANDING_ASSERT_H' '#ifdef NDEBUG' '#define assert(x) ((void)0)' '#else' '#define assert(x) ((void)((x) ? 0 : 0))' '#endif' '#endif' > build/bdt-freestanding/include/assert.h
  desc = freestanding-headers

build configs/menuconfig/.config: console scripts/kconfig_sync.py configs/menuconfig/Kconfig
  cmd = python3 scripts/kconfig_sync.py defconfig --preset full
  desc = defconfig

build defconfig: phony configs/menuconfig/.config

build olddefconfig: console configs/menuconfig/.config scripts/kconfig_sync.py configs/menuconfig/Kconfig
  cmd = python3 scripts/kconfig_sync.py olddefconfig
  desc = olddefconfig

build menuconfig: console configs/menuconfig/.config scripts/kconfig_sync.py configs/menuconfig/Kconfig
  cmd = python3 scripts/kconfig_sync.py menuconfig
  desc = menuconfig

build build/bdt-menuconfig/clks_config.h configs/menuconfig/config.clks.bdt: run configs/menuconfig/.config scripts/kconfig_sync.py configs/menuconfig/Kconfig
  cmd = python3 scripts/kconfig_sync.py export
  desc = menuconfig-headers

build build/x86_64/ninja_obj/clks/kernel/boot/limine/limine_requests.o: cc clks/kernel/boot/limine/limine_requests.c | build/bdt-freestanding/include/assert.h build/bdt-menuconfig/clks_config.h
  cc = gcc
  cflags = -std=c11 -ffreestanding -fno-stack-protector -fno-builtin -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0 -fcf-protection=none -g -Wall -Wextra -Werror -Wno-error=unused-variable -Wno-error=unused-parameter -Wno-error=unused-function -Ibuild/bdt-freestanding/include -Iclks/include -include build/bdt-menuconfig/clks_config.h -m64 -mno-red-zone -mcmodel=kernel -fno-pic -fno-pie -fno-PIE
  label = clks/kernel/boot/limine/limine_requests.c

build build/x86_64/ninja_obj/clks/kernel/core/interrupts.o: cc clks/kernel/core/interrupts.c | build/bdt-freestanding/include/assert.h build/bdt-menuconfig/clks_config.h
