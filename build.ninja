  desc = disk-image

build disk-image: phony build/x86_64/cleonos_disk.img

build run-clboot: console build/CLeonOS-CLBoot-x86_64.iso
  cmd = if [ -f /usr/share/OVMF/OVMF_CODE.fd ]; then OVMF=/usr/share/OVMF/OVMF_CODE.fd; elif [ -f /usr/share/ovmf/OVMF.fd ]; then OVMF=/usr/share/ovmf/OVMF.fd; else echo "run-clboot: OVMF firmware not found"; exit 1; fi; export GSETTINGS_BACKEND=memory; qemu-system-x86_64 -M q35 -m 1024M -bios "$$OVMF" -boot order=d -drive file=build/CLeonOS-CLBoot-x86_64.iso,format=raw,if=none,id=clksiso,media=cdrom,readonly=on -device ide-cd,drive=clksiso,bus=ide.0,bootindex=1 -netdev user,id=clksnet0 -device e1000,netdev=clksnet0 -serial stdio
  desc = run-clboot

build run: phony run-clboot

build run-clboot-harddisk: console build/x86_64/clboot_harddisk.img
  cmd = if [ -f /usr/share/OVMF/OVMF_CODE.fd ]; then OVMF=/usr/share/OVMF/OVMF_CODE.fd; elif [ -f /usr/share/ovmf/OVMF.fd ]; then OVMF=/usr/share/ovmf/OVMF.fd; else echo "run-clboot-harddisk: OVMF firmware not found"; exit 1; fi; export GSETTINGS_BACKEND=memory; qemu-system-x86_64 -M q35 -m 1024M -bios "$$OVMF" -boot order=c -drive file=build/x86_64/clboot_harddisk.img,format=raw,if=none,id=clbootdisk,media=disk -device ide-hd,drive=clbootdisk,bus=ide.0,bootindex=1 -netdev user,id=clksnet0 -device e1000,netdev=clksnet0 -serial stdio
  desc = run-clboot-harddisk

build kernel: phony build/x86_64/clks_kernel.elf

build all: phony clboot-iso

default all
